# @BotFather'dan alınan bot token'ı
TELEGRAM_BOT_TOKEN=

# https://aistudio.google.com/apikey adresinden alınan Gemini API anahtarı
GEMINI_API_KEY=
# Virgülle ayrılmış modeller sırayla denenir (yoğunluk/erişim hatasında bir sonrakine geçilir)
GEMINI_MODEL=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest,gemini-3.8-flash

# İlan sitesinin kaç dakikada bir taranacağı
TARAMA_ARALIGI_DK=30

# Gemini ücretsiz kotasını aşmamak için iki istek arası bekleme (ms)
GEMINI_ISTEK_ARALIGI_MS=7000

# /tara komutunu kullanabilecek Telegram chat id'leri (virgülle). Boşsa herkes kullanabilir.
ADMIN_CHAT_IDS=

# Veritabanı ve indirilen ilan PDF'lerinin tutulacağı klasör
VERI_KLASORU=data
